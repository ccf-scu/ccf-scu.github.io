# Dependencies and package-manager caches
node_modules/
.npm/
.pnpm-store/
.yarn/

# Astro and generated site output
.astro/
dist/

# Test and coverage output
coverage/
playwright-report/
test-results/
blob-report/

# Local development output
*.log
*.pid
.cache/
.temp/
.tmp/
tmp/

# Local secrets. Commit example files, never real values.
.env
.env.*
!.env.example

# Editor and operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Local visual QA artifacts; approved fixtures belong under tests/.
artifacts/
screenshots/local/


# Never ignore package lockfiles, content, migration manifests, docs, or source.
