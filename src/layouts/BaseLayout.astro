---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { organization } from "../lib/site";
import { withBase } from "../lib/content";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = organization.name,
  description = organization.description,
  image = "/uploads/featured/ccf-campus-talk.webp",
  noindex = false,
} = Astro.props;
const pageTitle = title === organization.name ? title : `${title} · ${organization.shortName}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const shareImage = Astro.site ? new URL(withBase(image), Astro.site) : withBase(image);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#b3172f" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,nofollow" : "index,follow"} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
  </body>
</html>
