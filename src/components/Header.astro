---
import { withBase } from "../lib/content";
const isHome = Astro.url.pathname === withBase("/");
---

<header class:list={["site-header", { "over-hero": isHome }]} data-site-header>
  <div class="nav-shell">
    <a class="brand" href={withBase("/")} aria-label="CCF 四川大学学生分会首页">
      <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="brand-copy"><strong>CCF · SCU</strong><small>四川大学学生分会</small></span>
    </a>
    <nav class="desktop-nav" aria-label="主导航">
      <a href={withBase("/about/")}>关于我们</a>
      <a href={withBase("/activities/")}>活动</a>
      <a href={withBase("/archive/")}>成就与档案</a>
      <a href={withBase("/search/")}>搜索</a>
    </nav>
    <div class="nav-actions">
      <span class="language-chip" aria-label="当前语言：中文">CN</span>
      <a class="nav-admin" href={withBase("/admin/")}>内容后台 <span aria-hidden="true">↗</span></a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
        <span class="sr-only">打开导航</span><i></i><i></i>
      </button>
    </div>
  </div>
  <nav class="mobile-nav" id="site-menu" aria-label="主导航" data-site-menu>
    <a href={withBase("/")}>首页</a><a href={withBase("/about/")}>关于我们</a>
    <a href={withBase("/activities/")}>活动</a><a href={withBase("/archive/")}>成就与档案</a>
    <a href={withBase("/search/")}>搜索</a><a href={withBase("/admin/")}>内容后台</a>
  </nav>
</header>

<script>
  const header = document.querySelector("[data-site-header]");
  const toggle = document.querySelector("[data-menu-toggle]");
  const menu = document.querySelector("[data-site-menu]");
  const close = () => {
    toggle?.setAttribute("aria-expanded", "false");
    header?.classList.remove("menu-open");
    document.body.classList.remove("nav-locked");
  };
  const updateHeader = () => header?.classList.toggle("is-scrolled", window.scrollY > 24);
  updateHeader();
  window.addEventListener("scroll", updateHeader, { passive: true });
  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") !== "true";
    toggle.setAttribute("aria-expanded", String(open));
    header?.classList.toggle("menu-open", open);
    document.body.classList.toggle("nav-locked", open);
  });
  menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", close));
  document.addEventListener("keydown", (event) => { if (event.key === "Escape") close(); });
</script>
