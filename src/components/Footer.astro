---
import { contacts } from "../lib/site";
import { withBase } from "../lib/content";
---

<footer class="site-footer">
  <div>
    <p class="eyebrow">CCF@SCU</p>
    <h2>在连接中成长，在行动中共振。</h2>
  </div>
  <div class="footer-links">
    {contacts.map((item) => item.link ? <a href={item.link}>{item.label} · {item.value}</a> : <span>{item.label} · {item.value}</span>)}
    <a href={withBase("/privacy/")}>隐私说明</a>
  </div>
  <p class="footer-meta">© {new Date().getFullYear()} CCF 四川大学学生分会 · 静态站点，内容变更由 Git 记录</p>
</footer>
