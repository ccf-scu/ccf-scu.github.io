---
import type { SearchIndexEntry } from "../lib/search";

interface Props {
  index: SearchIndexEntry[];
}

const { index } = Astro.props;
const serializedIndex = JSON.stringify(index).replaceAll("<", "\\u003c");
---

<dialog class="search-dialog" data-search-dialog data-search-root aria-labelledby="search-dialog-title">
  <div class="search-dialog-shell">
    <header class="search-dialog-header">
      <div><p class="eyebrow">SEARCH / LOCAL INDEX</p><h2 id="search-dialog-title">搜索分会档案</h2></div>
      <button class="search-dialog-close" type="button" data-search-close aria-label="关闭搜索">×</button>
    </header>
    <form class="search-box search-box-panel" role="search" data-search-form>
      <label class="sr-only" for="search-overlay-query">搜索关键词</label>
      <input id="search-overlay-query" type="search" autocomplete="off" placeholder="搜索活动、成员与公开档案" data-search-input />
      <button class="button button-white" type="submit">搜索 <span>↗</span></button>
    </form>
    <p class="search-count" data-search-count aria-live="polite">输入关键词开始搜索。</p>
    <div class="search-results" data-search-results></div>
    <script is:inline type="application/json" data-search-index set:html={serializedIndex}></script>
  </div>
</dialog>

<script>
  import "../scripts/search-ui";
</script>
