---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { contacts, homepage, links, organization } from "../lib/site";
import { categories, sortActivities, visibleAnnouncements, withBase } from "../lib/content";

const allActivities = sortActivities(await getCollection("activities"));
const announcements = visibleAnnouncements(await getCollection("announcements")).slice(0, homepage.announcementLimit);
const honors = (await getCollection("honors"))
  .filter((entry) => entry.data.visible && entry.data.featured)
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 4);
const categoryOrder = ["academic", "competition", "tutoring", "career"] as const;
const categoryCopy = {
  academic: ["FRONTIER", "把学术前沿带进校园", "连接专家报告、技术分享与前沿议题，让高质量学术资源进入校园。"],
  competition: ["ALGORITHM", "让训练成为进阶路径", "以训练营、经验分享和赛事组织支持实践成长。"],
  tutoring: ["LEARN", "让经验在同伴间流动", "围绕核心课程、经验传承与朋辈互助提供支持。"],
  career: ["FUTURE", "把视野延伸到校园之外", "连接企业、校友与更广阔的职业发展场景。"],
};
const fallbackImages = [
  "/uploads/featured/ccf-campus-talk.webp",
  "/uploads/featured/algorithm-training.webp",
  "/uploads/featured/full-marks-review.webp",
  "/uploads/featured/tencent-visit.webp",
];
const activityLayers = categoryOrder.map((category, index) => ({
  category,
  activity: allActivities.find((entry) => entry.data.category === category),
  copy: categoryCopy[category],
  image: allActivities.find((entry) => entry.data.category === category)?.data.cover ?? fallbackImages[index],
}));
const github = links.find((link) => /github/i.test(link.name));
const qq = contacts.find((item) => /QQ/i.test(item.label));
---

<BaseLayout>
  <section class="resonance-hero" data-resonance-hero tabindex="0" aria-describedby="resonance-guide">
    <div class="resonance-field" aria-hidden="true">
      <i class="field-orbit orbit-one"></i><i class="field-orbit orbit-two"></i>
      <i class="field-node node-one"></i><i class="field-node node-two"></i><i class="field-node node-three"></i>
    </div>
    <div class="resonance-coordinates" aria-hidden="true"><span>30.57° N / 104.07° E</span><span>FIELD 01 / SCU CCF</span></div>
    <div class="container resonance-shell">
      <div class="resonance-topline"><span>SCU CCF / KNOWLEDGE RESONANCE FIELD</span><span class="resonance-live"><i></i><strong data-resonance-state>等待一次移动</strong></span></div>
      <div class="resonance-copy reveal">
        <p class="eyebrow resonance-eyebrow"><span></span>{homepage.hero.eyebrow}</p>
        <h1>让一次好奇，<br />引发一场<em>共振。</em></h1>
        <p class="hero-lead">{homepage.hero.subtitle}</p>
        <div class="hero-actions">
          <a class="button button-white" href={withBase(homepage.hero.primaryLink)}>{homepage.hero.primaryLabel}<span>↗</span></a>
          <a class="button button-glass" href="#about">认识 SCU CCF <span>↓</span></a>
        </div>
      </div>
      <div class="resonance-readout" aria-hidden="true"><span>INPUT ENERGY</span><strong data-resonance-energy>008%</strong><i><b data-resonance-meter></b></i><small>QUESTION → KNOWLEDGE → COMMUNITY</small></div>
      <div class="resonance-guide" id="resonance-guide"><span class="signal-bars" aria-hidden="true"><i></i><i></i><i></i></span><span><strong>移动即产生共振，无需点击</strong><small>指针、触摸和方向键都会改变能量</small></span></div>
      <div class="resonance-foot"><span>向下探索我们的学术社区</span><i></i><span>MOVE&nbsp;&nbsp; TOUCH&nbsp;&nbsp; ARROW KEYS</span></div>
    </div>
  </section>

  <section class="section about-section" id="about">
    <div class="container">
      {announcements.length > 0 && <div class="announcement-strip">{announcements.map((entry) => <p><strong>NOTICE</strong><span>{entry.data.title} · {entry.data.summary}</span></p>)}</div>}
      <div class="split-heading reveal">
        <div><p class="section-label">01 / ABOUT</p><h2>为计算机学子，搭建一座<br />通往更大世界的桥。</h2></div>
        <div class="section-intro"><p>{organization.description} 分会成立于 {organization.founded} 年，是{organization.chapterNumber}。</p><a class="text-link" href={withBase("/about/")}>看看我们如何行动 <span>↘</span></a></div>
      </div>
      <div class="chapter-spectrum">
        <div class="spectrum-instrument reveal" aria-hidden="true">
          <div class="instrument-topline"><span>THE CHAPTER / CCF × SCU</span><span>01 — 03</span></div>
          <div class="spectrum-space"><i class="spectrum-orbit orbit-a"></i><i class="spectrum-orbit orbit-b"></i><i class="spectrum-orbit orbit-c"></i><span class="word word-a">RESEARCH</span><span class="word word-b">BUILD</span><span class="word word-c">TOGETHER</span><strong>∞</strong></div>
          <div class="instrument-caption"><span>ONE COMMUNITY</span><span>MORE THAN ONE DIRECTION</span></div>
        </div>
        <div class="chapter-principles">
          <article class="principle-row reveal"><span>01</span><div><small>RESEARCH / EXCHANGE</small><h3>让前沿，不再遥远</h3><p>依托 CCF 平台连接专家学者、企业导师与青年学生。</p></div></article>
          <article class="principle-row reveal"><span>02</span><div><small>PEOPLE / TOGETHER</small><h3>让成长，有路可循</h3><p>覆盖竞赛训练、课程学习、经验传承与生涯规划。</p></div></article>
          <article class="principle-row reveal"><span>03</span><div><small>LEARN / BUILD / SHARE</small><h3>让服务，成为成长</h3><p>通过本研协作与传帮带，在组织实践中共同成长。</p></div></article>
        </div>
        <blockquote class="spectrum-quote reveal"><span>“学会赋能、学院指导、学生主导。”</span><cite>SCU CCF<br />分会建设思路</cite></blockquote>
      </div>
    </div>
  </section>

  <section class="section activity-section" id="activities">
    <div class="container">
      <div class="section-heading reveal"><div><p class="section-label">02 / ACTIVITIES</p><h2>让成长有路径，<br />让活动成系列。</h2></div><p>围绕学生成长需求，分会形成学术引领、竞赛训练、学业帮扶、生涯发展四条主线。</p></div>
      <div class="activity-lab reveal" data-activity-lab data-active="academic">
        <div class="lab-bar"><span>SCU CCF / ACTIVITY LAYERS</span><span><i></i> 移动选择　<strong data-layer-index>01 / 04</strong></span></div>
        <div class="lab-stage">
          <div class="lab-copy" data-layer-copy>
            {activityLayers.map((layer, index) => <article class:list={[{ active: index === 0 }]} data-layer-panel={layer.category}><small>ACTIVE PROGRAM</small><span>{layer.copy[0]}</span><h3>{layer.copy[1]}</h3><p>{layer.copy[2]}</p>{layer.activity && <a href={withBase(`/activities/${layer.activity.id}/`)}>查看代表活动 ↗</a>}</article>)}
          </div>
          <div class="layer-rings" aria-hidden="true"><i></i><i></i><i></i></div>
          <div class="possibility-deck">
            {activityLayers.map((layer, index) => <article class:list={["possibility-sheet", `sheet-${index + 1}`, { active: index === 0 }]} data-layer-card={layer.category}><div><span>{String(index + 1).padStart(2,"0")} / {layer.copy[0]}</span><span>CCF · SCU</span></div><figure><img src={withBase(layer.image)} alt="" loading="lazy" /><b aria-hidden="true">{index === 0 ? "Σ" : index === 1 ? "</>" : index === 2 ? "A+" : "↗"}</b></figure><small>{categories[layer.category]}</small><strong>{layer.activity?.data.title ?? layer.copy[1]}</strong></article>)}
          </div>
        </div>
        <div class="layer-tabs" role="tablist" aria-label="活动方向">
          {activityLayers.map((layer, index) => <button class:list={[{ active: index === 0 }]} type="button" role="tab" aria-selected={index === 0 ? "true" : "false"} data-layer-tab={layer.category}><span>{String(index + 1).padStart(2,"0")}</span><strong>{categories[layer.category]}</strong></button>)}
        </div>
      </div>
      <div class="activity-note"><span>i</span><p>当前已整理 {allActivities.length} 条活动档案；浏览完整列表可按类别筛选并查看详情。</p><a href={withBase("/activities/")}>浏览全部活动 ↗</a></div>
    </div>
  </section>

  <section class="achievement-section" id="achievements">
    <div class="container">
      <div class="achievement-heading reveal"><p class="section-label light">03 / ACHIEVEMENTS</p><h2>成果不是终点，<br />是下一次出发的坐标。</h2><p>自 2012 年成立以来，分会持续记录品牌活动、竞赛成绩、集体荣誉与成员成长。</p></div>
      <div class="archive-composer reveal">
        <div class="archive-index"><p><i></i> ARCHIVE / 2012—2026</p><h3>把分会走过的路，<br />变成下一程坐标。</h3><span>公开档案由 Git 持续保存，图片与年份将在上线前再次核对。</span><a href={withBase("/archive/")}>进入完整档案 ↗</a></div>
        <div class="archive-deck">
          {honors.slice(0,3).map((honor, index) => <article class={`archive-sheet archive-sheet-${index + 1}`}><div><span>HONOR RECORD</span><span>{String(index + 1).padStart(2,"0")} / 03</span></div>{honor.data.image && <img src={withBase(honor.data.image)} alt={honor.data.imageAlt ?? honor.data.title} loading="lazy" />}<small>{honor.data.year} / CCF SCU</small><strong>{honor.data.title}</strong></article>)}
        </div>
      </div>
      <div class="timeline"><article><span>2026</span><i></i><div><small>CURRENT CHAPTER</small><h3>让品牌活动持续发生</h3><p>活动覆盖学术、竞赛、学业、生涯与组织建设。</p></div></article><article><span>2013—25</span><i></i><div><small>COLLECTIVE HONORS</small><h3>多次获评 CCF 优秀学生分会</h3><p>荣誉和公开资料按年份进入可追溯档案。</p></div></article><article><span>2012</span><i></i><div><small>CHAPTER ARCHIVE</small><h3>全国第 7 个 CCF 学生分会</h3><p>持续搭建 CCF 与川大学生会员之间的桥梁。</p></div></article></div>
    </div>
  </section>

  <section class="section open-section"><div class="container"><div class="open-card reveal"><div class="open-copy"><p class="section-label">04 / OPEN SOURCE</p><h2>分享代码，<br />也分享思考。</h2><p>分会官方网站源码与内容档案由 Git 管理，公开内容的每次修改都可追溯。</p>{github && <a class="button button-dark" href={github.url} target="_blank" rel="noopener noreferrer">GitHub <span>↗</span></a>}</div><div class="repo-preview"><div><span>ccf-scu /</span><strong>ccf-scu.github.io</strong><small>Public</small></div><p>CCF 四川大学学生分会官方网站与内容档案</p><ul><li><span>◇</span><b>activities/</b><small>activity archive</small></li><li><span>◇</span><b>members/</b><small>chapter history</small></li><li><span>≡</span><b>admin/</b><small>content workflow</small></li></ul><footer><span><i></i> Astro / Markdown / Decap</span><span>Public repository</span></footer></div></div></div></section>

  <section class="join-section" id="join"><div class="join-atmosphere" aria-hidden="true"><i></i><i></i><i></i><strong>SCU<br />CCF</strong></div><div class="container join-finale"><div class="join-heading reveal"><p class="section-label light">05 / JOIN US · FINAL CHAPTER</p><h2>把你的下一次好奇，<br />带到这里。</h2><p>{homepage.recruitment.summary}</p><div class="join-buttons"><a class="button button-white" href={withBase("/about/#contact")}>加入我们 <span>↗</span></a><a class="button button-glass" href={withBase("/activities/")}>关注活动 <span>＋</span></a></div></div><ol class="join-route"><li><span>01</span><strong>加入迎新群</strong><small>{qq ? `${qq.label} ${qq.value}，获取活动通知与会员资讯。` : "获取活动通知与会员资讯。"}</small></li><li><span>02</span><strong>关注活动</strong><small>从学术、竞赛、学业或生涯活动中找到入口。</small></li><li><span>03</span><strong>参与执委招募</strong><small>每学年招募期关注公开通知。</small></li></ol><div class="join-signature"><span>CURIOUS IN</span><i></i><strong>POSSIBILITY OUT</strong></div></div></section>
</BaseLayout>

<script>
  const lab = document.querySelector("[data-activity-lab]");
  const tabs = [...document.querySelectorAll("[data-layer-tab]")];
  const panels = [...document.querySelectorAll("[data-layer-panel]")];
  const cards = [...document.querySelectorAll("[data-layer-card]")];
  const index = document.querySelector("[data-layer-index]");
  const selectLayer = (category: string | null) => {
    if (!category) return;
    lab?.setAttribute("data-active", category);
    tabs.forEach((tab, tabIndex) => { const active = tab.getAttribute("data-layer-tab") === category; tab.classList.toggle("active", active); tab.setAttribute("aria-selected", String(active)); if (active && index) index.textContent = `${String(tabIndex + 1).padStart(2,"0")} / 04`; });
    panels.forEach((panel) => panel.classList.toggle("active", panel.getAttribute("data-layer-panel") === category));
    cards.forEach((card) => card.classList.toggle("active", card.getAttribute("data-layer-card") === category));
  };
  tabs.forEach((tab) => tab.addEventListener("click", () => selectLayer(tab.getAttribute("data-layer-tab"))));

  const hero = document.querySelector<HTMLElement>("[data-resonance-hero]");
  const energy = document.querySelector("[data-resonance-energy]");
  const meter = document.querySelector<HTMLElement>("[data-resonance-meter]");
  const state = document.querySelector("[data-resonance-state]");
  const resonate = (amount: number, x = 70, y = 44) => {
    const value = Math.max(8, Math.min(100, Math.round(amount)));
    hero?.style.setProperty("--resonance-x", `${x}%`); hero?.style.setProperty("--resonance-y", `${y}%`);
    if (energy) energy.textContent = `${String(value).padStart(3,"0")}%`;
    if (meter) meter.style.width = `${value}%`;
    if (state) state.textContent = value > 55 ? "共振持续传播" : "捕捉到一次移动";
    hero?.classList.add("resonating");
  };
  hero?.addEventListener("pointermove", (event: PointerEvent) => { const box = hero.getBoundingClientRect(); const x = (event.clientX - box.left) / box.width * 100; const y = (event.clientY - box.top) / box.height * 100; resonate(18 + Math.abs(event.movementX + event.movementY) * 3, x, y); });
  hero?.addEventListener("keydown", (event: KeyboardEvent) => { if (["ArrowUp","ArrowDown","ArrowLeft","ArrowRight"].includes(event.key)) { event.preventDefault(); resonate(68); } });

</script>
