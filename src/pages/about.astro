---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { contacts, organization, teachers } from "../lib/site";
import { sortMembersByCohort, withBase } from "../lib/content";
const members = sortMembersByCohort(await getCollection("members", ({ data }) => data.visible));
const currentCohort = members[0]?.data.cohort;
const currentMembers = members.filter((entry) => entry.data.cohort === currentCohort);
const renderedMembers = await Promise.all(currentMembers.map(async (member) => ({ member, Content: (await render(member)).Content })));
---

<BaseLayout title="关于分会" description={organization.description}>
  <header class="page-hero"><p class="eyebrow">ABOUT CCF@SCU</p><h1>关于分会</h1><p>{organization.description}</p></header>
  <section class="page-section"><div class="page-container"><div class="section-head"><div><p class="eyebrow">OUR STORY</p><h2>连接专业共同体与校园成长</h2></div><p>分会成立于 {organization.founded} 年，是{organization.chapterNumber}。我们坚持让专业资源走进校园，也让学生在真实行动中成长。</p></div><div class="direction-grid"><article class="direction-card"><span>01</span><h3>学术交流</h3><p>连接专家、青年学者和前沿议题。</p></article><article class="direction-card"><span>02</span><h3>朋辈成长</h3><p>让经验、方法和机会在同学之间流动。</p></article><article class="direction-card"><span>03</span><h3>实践服务</h3><p>通过策划与执行培养责任感和协作能力。</p></article><article class="direction-card"><span>04</span><h3>长期传承</h3><p>用公开档案、流程和工具支持换届交接。</p></article></div></div></section>
  {teachers.length > 0 && <section class="page-section"><div class="page-container"><div class="section-head"><div><p class="eyebrow">ADVISORS</p><h2>指导老师</h2></div><p>老师们为分会的学术交流、组织建设与长期发展提供指导。</p></div><div class="member-grid">{teachers.map((teacher) => <article class="direction-card">{teacher.photo && <img src={withBase(teacher.photo)} alt={teacher.photoAlt ?? teacher.name} />}<h3>{teacher.name}</h3><p>{teacher.title}</p><p>{teacher.summary}</p></article>)}</div></div></section>}
  <section class="page-section"><div class="page-container"><div class="section-head"><div><p class="eyebrow">CURRENT COMMITTEE</p><h2>{currentCohort ? `${currentCohort} 执委` : "当前执委"}</h2></div><p>点击卡片，认识正在共同策划活动、服务同学与建设分会的伙伴。</p></div>{renderedMembers.length ? <div class="member-grid">{renderedMembers.map(({member,Content}) => <>
    <button class="member-card" type="button" data-member-open={member.id} aria-haspopup="dialog"><span class="member-avatar">{member.data.photo ? <img src={withBase(member.data.photo)} alt={member.data.photoAlt ?? member.data.name} /> : member.data.name.slice(0,1)}</span><span><strong>{member.data.name}</strong><small>{member.data.role}</small></span></button>
    <dialog class="member-dialog" data-member-dialog={member.id} aria-labelledby={`member-title-${member.id}`}><div class="member-dialog-shell"><header><div class="member-dialog-identity"><span class="member-avatar member-dialog-avatar">{member.data.photo ? <img src={withBase(member.data.photo)} alt="" /> : member.data.name.slice(0,1)}</span><div><p class="eyebrow">{member.data.cohort}</p><h2 id={`member-title-${member.id}`}>{member.data.name}</h2><p>{member.data.role}</p></div></div><button class="member-dialog-close" type="button" data-member-close aria-label={`关闭${member.data.name}的介绍`}>×</button></header><div class="member-profile prose">{member.data.profileConfirmed ? <Content /> : <p>个人介绍尚待确认。</p>}</div></div></dialog>
  </>)}</div> : <div class="empty-state">成员档案将在这里持续更新。</div>}</div></section>
  <section class="page-section" id="contact"><div class="page-container"><div class="recruitment"><div><p class="eyebrow">CONTACT</p><h2>加入我们</h2><p>关注活动、加入迎新群，或在每学年招募期参与执委工作。</p></div><div>{contacts.map((item) => item.link ? <p><a class="button button-secondary" href={item.link}>{item.label} · {item.value}</a></p> : <p><span class="button button-secondary">{item.label} · {item.value}</span></p>)}</div></div></div></section>
</BaseLayout>

<script>
  import "../scripts/member-dialog";
</script>
